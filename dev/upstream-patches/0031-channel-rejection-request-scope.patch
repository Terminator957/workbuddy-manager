diff --git a/internal/server/channel_rejected_test.go b/internal/server/channel_rejected_test.go
new file mode 100644
index 0000000..0163dbc
--- /dev/null
+++ b/internal/server/channel_rejected_test.go
@@ -0,0 +1,57 @@
+package server
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/upstream"
+)
+
+var channelRejectedBody = `{"code":11128,"msg":"Illegal API invocation from an unapproved channel","requestId":"channel-test"}`
+
+func TestChannelRejectedDoesNotRotateOrFallback(t *testing.T) {
+	calls := 0
+	up := &upstream.Client{
+		HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			calls++
+			return &http.Response{
+				StatusCode: 400,
+				Header:     http.Header{"Content-Type": []string{"application/json"}},
+				Body:       io.NopCloser(strings.NewReader(channelRejectedBody)),
+			}, nil
+		})},
+		ChatBaseCN:    "https://fake.example",
+		BillingBaseCN: "https://fake.example",
+	}
+	p := testPoolWith(
+		&auth.Auth{UID: "u1", AccessToken: "at1", ExpiresAt: 9999999999},
+		&auth.Auth{UID: "u2", AccessToken: "at2", ExpiresAt: 9999999999},
+	)
+	h := NewHandler(Config{Pool: p, Upstream: up, SoftCooldown: 600 * time.Second})
+
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest("POST", "/v1/chat/completions",
+		strings.NewReader(`{"model":"glm-5.2","stream":true,"messages":[{"role":"user","content":"hi"}]}`)))
+
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("应回 400（渠道拒绝），got %d body=%s", rec.Code, rec.Body.String())
+	}
+	if calls != 1 {
+		t.Errorf("不该轮转（同一 body 换号结果不变，白扔配额）：上游被调用了 %d 次", calls)
+	}
+	if !strings.Contains(rec.Body.String(), "11128") {
+		t.Errorf("应透传上游原文（含 code，客户端按它自查）：%s", rec.Body.String())
+	}
+	// 不罚号：两个号都不该被冷却/禁用
+	for _, uid := range []string{"u1", "u2"} {
+		st, _ := p.Status(uid)
+		if st.Cooling || st.Disabled || st.ConsecutiveFails != 0 || len(st.RateLimitedModels) != 0 {
+			t.Errorf("%s 不该被罚（这是请求的问题）：%+v", uid, st)
+		}
+	}
+}
