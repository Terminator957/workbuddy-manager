+++ b/internal/server/tool_search_scope_test.go
@@ -0,0 +1,82 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/upstream"
+)
+
+func TestSearchQuotaDoesNotPoisonChat(t *testing.T) {
+	rec := &searchRecorder{}
+	up := newSearchUpstream(t, rec, `{"code":15001,"msg":"quota_web_search"}`, searchOK)
+	h := newSearchHandler(up, &auth.Auth{UID: "u1", AccessToken: "test", ExpiresAt: 9999999999})
+	res := httptest.NewRecorder()
+	h.ServeHTTP(res, searchReq(`{"query":"q"}`))
+	if res.Code != 429 {
+		t.Fatalf("search quota: %d", res.Code)
+	}
+	if len(h.cfg.Pool.AvailableUIDsForModel("deepseek-v4.1-flash")) != 1 {
+		t.Fatal("search-only quota removed the account from chat")
+	}
+	if len(h.cfg.Pool.AvailableUIDsForModel("tool:web-search")) != 0 {
+		t.Fatal("search quota must suppress further search requests during cooldown")
+	}
+	res = httptest.NewRecorder()
+	h.ServeHTTP(res, searchReq(`{"query":"q"}`))
+	if rec.callCount() != 1 {
+		t.Fatal("search cooldown was ignored")
+	}
+	h.cfg.Pool.CooldownSoftForModel("u1", time.Minute, time.Now().Add(-time.Second), "tool:web-search", "expired")
+	time.Sleep(5 * time.Millisecond) // Pool clamps a past deadline to now + 1ms.
+	res = httptest.NewRecorder()
+	h.ServeHTTP(res, searchReq(`{"query":"q"}`))
+	if res.Code != 200 || rec.callCount() != 2 {
+		t.Fatal("expired search cooldown did not recover")
+	}
+}
+
+func TestSearchRealmDoesNotFallBackAcrossRegions(t *testing.T) {
+	for _, tc := range []struct{ domain, realm string }{{"www.workbuddy.cn", "global"}, {"www.workbuddy.ai", "cn"}} {
+		t.Run(tc.realm, func(t *testing.T) {
+			rec := &searchRecorder{}
+			h := newSearchHandler(newSearchUpstream(t, rec, searchOK), &auth.Auth{UID: "u1", Domain: tc.domain, AccessToken: "test", ExpiresAt: 9999999999})
+			res := httptest.NewRecorder()
+			h.ServeHTTP(res, searchReq(`{"query":"q","realm":"`+tc.realm+`"}`))
+			if res.Code != 503 || rec.callCount() != 0 {
+				t.Fatalf("cross-region search: status=%d calls=%d", res.Code, rec.callCount())
+			}
+		})
+	}
+}
+
+func TestSearchInvalidRealmRejected(t *testing.T) {
+	h := newSearchHandler(&upstream.Client{})
+	res := httptest.NewRecorder()
+	h.ServeHTTP(res, searchReq(`{"query":"q","realm":"unexpected"}`))
+	if res.Code != 400 {
+		t.Fatalf("invalid realm: %d", res.Code)
+	}
+}
+
+func TestSearchChannel401DoesNotPenalizeOrRotate(t *testing.T) {
+	calls := 0
+	up := &upstream.Client{AgentToolBaseOverride: "https://test.invalid", HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return sseResponse(401, channelCheckBody()), nil
+	})}}
+	h := newSearchHandler(up, &auth.Auth{UID: "u1", AccessToken: "test", ExpiresAt: 9999999999}, &auth.Auth{UID: "u2", AccessToken: "test2", ExpiresAt: 9999999999})
+	res := httptest.NewRecorder()
+	h.ServeHTTP(res, searchReq(`{"query":"q"}`))
+	if res.Code != 400 || calls != 1 {
+		t.Fatalf("channel rejection: status=%d calls=%d", res.Code, calls)
+	}
+	for _, st := range h.cfg.Pool.List() {
+		if st.Cooling || st.Disabled || st.ConsecutiveFails != 0 || len(st.RateLimitedModels) != 0 || st.InFlight != 0 {
+			t.Fatal("channel rejection mutated account availability")
+		}
+	}
+}
